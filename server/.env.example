DATABASE_URL=postgresql://lms:lms_local@localhost:5432/lms?schema=public
# Runtime pool settings (Prisma-managed PostgreSQL pool).
DB_CONNECTION_LIMIT=10
DB_POOL_TIMEOUT=10
# Optional runtime overrides: DB_HOST_NAME, DB_PORT, DB_USER, DB_PASSWORD, DB_NAME.
# Keep DATABASE_URL consistent with any overrides because Prisma CLI uses it.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SESSION_SECRET=replace-with-a-separate-random-secret-at-least-32-characters
PORT=4000
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174,http://alpha.localhost:5173,http://beta.localhost:5173
# When HTTPS is terminated by a local reverse proxy, set TRUST_PROXY=loopback.
# Configure only the actual trusted proxy addresses in your deployment (a hop count such as 1,
# 'loopback', 'uniquelocal' or comma-separated IPs/subnets). TRUST_PROXY=true is rejected.
# TRUST_PROXY=loopback

# Logging: console plus daily JSON files in server/logs (app-YYYY-MM-DD.log).
# LOG_LEVEL=info            # error | warn | info | debug
# LOG_TO_FILE=true
# LOG_DIR=./logs
# LOG_RETENTION_DAYS=14

# Allowlisted upstream services for /api/proxy/:service/*. JSON on one line. Keep API keys in
# their own variables and reference them with apiKeyEnv.
# PROXY_TARGETS={"judge":{"url":"http://localhost:2358","roles":["TEACHER","STUDENT"],"timeoutMs":10000,"apiKeyHeader":"x-api-key","apiKeyEnv":"JUDGE_API_KEY"}}
# JUDGE_API_KEY=replace-with-the-upstream-key

# Lesson uploads (video: MP4/WebM, documents: PDF). Stored under UPLOAD_DIR (default server/uploads).
# UPLOAD_DIR=./uploads
# UPLOAD_MAX_VIDEO_MB=500
# UPLOAD_MAX_DOCUMENT_MB=50

# Email (password reset links). Without SMTP_HOST, development logs the email text instead of sending it.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=replace-with-smtp-user
# SMTP_PASSWORD=replace-with-smtp-password
# MAIL_FROM=Campus LMS <no-reply@your-domain>
# Frontend address used in emailed links when the request has no allowed Origin header.
# APP_URL=http://localhost:5173

# "Create course from a PDF" runs scripts/pdf-course.py, which needs Python 3 with PyMuPDF (pip install pymupdf).
# PYTHON_PATH=python

# Coding practice. CODE_RUNNER=local runs programs on this server (development / trusted lab only),
# judge0 sends them to a Judge0 sandbox (recommended for production), off disables Run/Submit.
# Default: local in development, off in production.
# CODE_RUNNER=local
# JUDGE0_URL=http://judge0.internal:2358
# JUDGE0_KEY=
# CODE_RUNNER_PARALLEL=4
# Local toolchains (only languages whose compiler is found are offered): python and node are used directly;
# JAVA_HOME=C:\Program Files\Java\jdk-21
# GCC_PATH=gcc
# GXX_PATH=g++

# Coding judge queue. The API starts a worker in its own process unless JUDGE_WORKER=off; then run
# `npm run judge -w server` (node judge-worker.js) on one or more machines sharing this database.
# JUDGE_WORKER=inline
# JUDGE_SLOTS=4            programs one worker runs at once
# JUDGE_COLLEGE_SLOTS=2    programs one college may have running at once (fairness during exams)
# JUDGE_MAX_QUEUE=500      queued submissions before new ones are refused politely
