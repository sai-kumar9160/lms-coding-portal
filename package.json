{
    "name":  "campus-lms",
    "private":  true,
    "workspaces":  [
                       "client",
                       "server"
                   ],
    "scripts":  {
                    "dev":  "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
                    "build":  "npm run build -w server \u0026\u0026 npm run build -w client",
                    "db:setup":  "npm run db:setup -w server",
                    "db:export": "node server/scripts/export-sql.mjs",
                    "test":  "npm run test -w server"
                },
    "devDependencies":  {
                            "concurrently":  "^9.1.2",
                            "deepmerge-ts":  "^8.0.2",
                            "effect":  "^3.22.2"
                        },
    "overrides":  {
                      "deepmerge-ts":  "$deepmerge-ts",
                      "effect":  "$effect",
                      "shell-quote":  "^1.10.1"
                  }
}
